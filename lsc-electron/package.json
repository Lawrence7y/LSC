{
  "name": "lsc-electron",
  "version": "1.0.11",
  "description": "LSC 直播切片系统 - Electron 版本",
  "author": "Lawrence7y",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lawrence7y/LSC"
  },
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "electron": "vite --config vite.config.ts",
    "electron:build": "tsc --noEmit && vite build && electron-builder",
    "release": "vite build && electron-builder --publish always",
    "prep-bundle": "powershell -ExecutionPolicy Bypass -File scripts/prep-bundle.ps1",
    "prep-bundle:store": "powershell -ExecutionPolicy Bypass -File scripts/prep-bundle.ps1 -WithDeps",
    "build:full": "powershell -ExecutionPolicy Bypass -File scripts/prep-bundle.ps1 && tsc --noEmit && vite build && electron-builder",
    "build:msix": "powershell -ExecutionPolicy Bypass -File scripts/build-msix.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@tanstack/react-virtual": "^3.14.9",
    "antd": "^5.12.0",
    "dayjs": "^1.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.6.1",
    "electron": "^30.5.1",
    "electron-builder": "^24.9.1",
    "happy-dom": "^13.10.1",
    "sharp": "^0.33.5",
    "sharp-ico": "^0.1.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-electron": "^1.1.0",
    "vitest": "^1.6.1"
  },
  "build": {
    "appId": "com.lsc.app",
    "productName": "LSC 直播切片系统",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron",
      "dist"
    ],
    "extraResources": [
      {
        "from": "../python-backend",
        "to": "python-backend"
      },
      {
        "from": "../lsc",
        "to": "lsc"
      },
      {
        "from": "../scripts",
        "to": "scripts"
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "../requirements-ai.txt",
        "to": "requirements-ai.txt"
      },
      {
        "from": "scripts/install-runtime-dependencies.ps1",
        "to": "install-runtime-dependencies.ps1"
      },
      {
        "from": ".bundle/python",
        "to": "python",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!**/__pycache__/**",
          "!*.pyc",
          "!python-packages/**",
          "!Scripts/**",
          "!pip/**",
          "!setuptools/**",
          "!pkg_resources/**"
        ]
      },
      {
        "from": ".bundle/uv",
        "to": "uv",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".bundle/python/python-packages",
        "to": "python-packages",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!*.pyc"
        ]
      },
      {
        "from": ".bundle/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Lawrence7y",
      "repo": "LSC",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis",
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "appx": {
      "artifactName": "LiveStreamClipper-${version}.${ext}",
      "publisher": "CN=B2250643-15B9-4016-82B3-C97EAFA5DABD",
      "publisherDisplayName": "Lawrence7YY",
      "displayName": "Live Stream Clipper",
      "identityName": "Lawrence7YY.LiveStreamClipper",
      "applicationId": "LiveStreamClipper",
      "backgroundColor": "#000000",
      "showNameOnTiles": true
    }
  }
}
